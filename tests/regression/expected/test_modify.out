-- Check that modifying properties of registered NFT type works correctly
-- Given
CALL insert_nft_register_op(block_num=>1, auth=>'alice', symbol=>'alice/ABC', name=>'test', owner=>'alice', issuers=>ARRAY['alice'], max_count=>12);
CALL insert_nft_modify_op(block_num=>2, auth=>'alice', name=>'test-mod', symbol=>'alice/ABC', owner=>'bob', issuers=>ARRAY['bob'], max_count=>11);
CALL insert_nft_modify_op(block_num=>3, auth=>'bob', name=>'test-3', symbol=>'alice/ABC', owner=>'charlie', issuers=>ARRAY['charlie'], max_count=>12); -- Incrementing max_count should fail
-- When
CALL nfttracker_sync_blocks();
NOTICE:  Registering index dependency hive_operations_custom_json_types_1_idx for custom_json types: {NFT} (IDs: {1})
NOTICE:  Last block processed by application: 0
NOTICE:  Entering application main loop...
WARNING:  PROFILE: 'nfttracker_app' STAGE_CHANGED from 'N/A' to 'live' after N/A block: 1 fork: 1 head block: 9 head fork: 1
WARNING:  PROFILE: 'nfttracker_app' ATTACHED stage: 'live' block: 1 fork: 1 head block: 9 head fork: 1
WARNING:  Error processing action modify in block 3: Cannot increment max_count for symbol alice/ABC.
NOTICE:  Blocks limit reached. Exiting application main loop at processed block: 3.
-- Then
SELECT creator, owner, symbol, name, max_count, issuers FROM types_view;
 creator | owner | symbol |   name   | max_count | issuers 
---------+-------+--------+----------+-----------+---------
 alice   | bob   | ABC    | test-mod |        11 | {bob}
