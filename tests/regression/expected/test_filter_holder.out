-- Test 10: holder=alice + pagination (count=1) => 1
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','alice',1,NULL));
 count 
-------
     1
(1 row)

-- Test 11: holder=alice + pagination page 2 using last_id from first instance
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','alice',1,
    (SELECT (unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','alice',1,NULL))).id)));
