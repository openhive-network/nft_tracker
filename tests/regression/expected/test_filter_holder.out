-- Test 1: holder=alice (no tags) => 2
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','alice',NULL,NULL));
 count 
-------
     2
(1 row)

-- Test 2: holder=bob => 2
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','bob',NULL,NULL));
 count 
-------
     2
(1 row)

-- Test 3: holder=dan => 2
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','dan',NULL,NULL));
 count 
-------
     2
(1 row)

-- Test 4: no holder (NULL) => all 6
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC',NULL,NULL,NULL));
 count 
-------
     6
(1 row)

-- Test 5: nonexistent holder => 0
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances('alice','ABC','charlie',NULL,NULL));
 count 
-------
     0
(1 row)

-- Test 6: holder=alice + tag=X => 1
SELECT COUNT(*) FROM unnest(nfttracker_endpoints.get_nft_instances_with_tags('alice','ABC','X','alice',NULL,NULL));
 count 
-------
     1
(1 row)

-- Test 7: holder=bob + tag=Y => 1
