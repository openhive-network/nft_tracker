-- Test the holder filter parameter on get_nft_instances and get_nft_instances_with_tags
-- Given: register alice/ABC with max_count=10
CALL insert_nft_register_op(block_num=>1, auth=>'alice', symbol=>'alice/ABC', name=>'t', owner=>'alice', issuers=>ARRAY['alice'], max_count=>10);
-- Issue 6 instances across 3 holders with 2 tags (X and Y)
CALL insert_nft_issue_op(block_num=>2, auth=>'alice', symbol=>'alice/ABC', holder=>'alice', data=>'{}', tags=>ARRAY['X']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>3, auth=>'alice', symbol=>'alice/ABC', holder=>'bob',   data=>'{}', tags=>ARRAY['X']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>4, auth=>'alice', symbol=>'alice/ABC', holder=>'dan',   data=>'{}', tags=>ARRAY['X']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>5, auth=>'alice', symbol=>'alice/ABC', holder=>'alice', data=>'{}', tags=>ARRAY['Y']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>6, auth=>'alice', symbol=>'alice/ABC', holder=>'bob',   data=>'{}', tags=>ARRAY['Y']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>7, auth=>'alice', symbol=>'alice/ABC', holder=>'dan',   data=>'{}', tags=>ARRAY['Y']::nfttracker_app.tags, soulbound=>FALSE);
-- When
CALL nfttracker_sync_blocks();
