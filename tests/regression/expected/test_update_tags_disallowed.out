-- Check that accounts that are not issuers cannot update instance tags
-- Given
CALL insert_nft_register_op(block_num=>1, auth=>'alice', symbol=>'alice/XYZ', name=>'test', owner=>'alice', issuers=>ARRAY['alice'], max_count=>12);
CALL insert_nft_issue_op(block_num=>2, auth=>'alice', symbol=>'alice/XYZ', holder=>'alice', data=>'{}', tags=>ARRAY['orig']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_modify_op(block_num=>3, auth=>'alice', symbol=>'alice/XYZ', name=>'test', owner=>'alice', issuers=>ARRAY[]::hafd.account_name_type[], max_count=>12);
CALL insert_nft_update_tags_op(block_num=>4, pos=>1, auth=>'alice', symbol=>'alice/XYZ', ids=>ARRAY[expected_instance_id(2,0,1)], tags=>ARRAY['alice']::nfttracker_app.tags);
CALL insert_nft_update_tags_op(block_num=>4, pos=>2, auth=>'bob', symbol=>'alice/XYZ', ids=>ARRAY[expected_instance_id(2,0,1)], tags=>ARRAY['bob']::nfttracker_app.tags);
CALL insert_nft_update_tags_op(block_num=>4, pos=>3, auth=>'charlie', symbol=>'alice/XYZ', ids=>ARRAY[expected_instance_id(2,0,1)], tags=>ARRAY['charlie']::nfttracker_app.tags);
-- When
