CALL insert_nft_register_op(block_num=>1, pos=>2, auth=>'bob', symbol=>'bob/ABC', name=>'test', owner=>'bob', issuers=>ARRAY['bob']::hafd.account_name_type[], max_count=>12);
CALL insert_nft_register_op(block_num=>1, pos=>3, auth=>'charlie', symbol=>'charlie/ABC', name=>'test', owner=>'charlie', issuers=>ARRAY['charlie']::hafd.account_name_type[], max_count=>12);
CALL insert_nft_issue_op(block_num=>2, pos=>1, auth=>'alice', symbol=>'alice/ABC', holder=>'alice', data=>'{}', tags=>ARRAY['orig']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>2, pos=>2, auth=>'bob', symbol=>'bob/ABC', holder=>'bob', data=>'{}', tags=>ARRAY['orig']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_issue_op(block_num=>2, pos=>3, auth=>'charlie', symbol=>'charlie/ABC', holder=>'charlie', data=>'{}', tags=>ARRAY['orig']::nfttracker_app.tags, soulbound=>FALSE);
CALL insert_nft_update_tags_op(block_num=>3, pos=>1, auth=>'alice', symbol=>'alice/ABC', ids=>ARRAY[expected_instance_id(2,1,1)], tags=>ARRAY['updated']::nfttracker_app.tags);
