#
# Homepage and endpoints of the NFT Tracker API.
#
worker_processes  auto;
error_log /dev/stdout info;
worker_rlimit_nofile 8192;

events {
  worker_connections 4096;
}
http {
    access_log /dev/stdout;

    # hive.rpc_form forwards a REST GET of a function as a form POST, so an argument
    # starting with a PostgREST operator (not., eq., ...) reaches the function as a
    # value. rpc_arguments.lua is generated by scripts/openapi_rewrite.sh.
    init_by_lua_block {
        rpc_form = require "hive.rpc_form"
        rpc_arguments = dofile(ngx.config.prefix() .. "conf/rpc_arguments.lua")
    }

    server {
            listen 0.0.0.0:80 default_server;
            server_name _;

            location / {
                    include rewrite_rules.conf;
                    # ${REWRITE_LOG} will be replaced by the docker entrypoint script.
                    # Set REWRITE_LOG=on in the environment to enable rewrite logging,
                    # otherwise it will remain disabled
                    ${REWRITE_LOG}

                    rewrite_by_lua_block { rpc_form.forward(rpc_arguments) }
                    header_filter_by_lua_block { rpc_form.restore_head() }

                    proxy_pass  http://nft-tracker-postgrest:3000;  # PostgREST endpoint

                    proxy_set_header Host $host;
                    proxy_set_header X-Real-IP $remote_addr;
                    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                    proxy_hide_header Content-Location;
                    proxy_set_header  Connection "";
                    proxy_http_version 1.1;
            }
    }
    server {
        listen 0.0.0.0:81;

        location /health {
            return 204;
        }
    }
}